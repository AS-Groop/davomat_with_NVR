# ══════════ MMTRI Davomat tizimi — sozlamalar ══════════
# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env faylni HECH KIMGA bermang — unda parollar bor.

# Dashboard (katta ekran) paroli — kuchli parol qo'ying
DASHBOARD_PASSWORD=bu-yerga-kuchli-parol

# ── FaceID ma'lumot manbasi ──
#   demo    — qurilmasiz sinov (soxta ma'lumot)
#   devices — FaceID qurilmalari (faceid_devices.json da ro'yxat)
#   biocontrol — OneDesk/BioControl API (enter.mininnovation.uz)
FACEID_SOURCE=demo

# Qurilma parollari (faceid_devices.json dagi "password_env" nomlari)
FACEID_PASS_1=
FACEID_PASS_2=

# Faqat FACEID_SOURCE=biocontrol bo'lsa:
# BIOCONTROL_API_URL=https://enter.mininnovation.uz/api.php

# ── Ish tartibi ──
WORK_START=09:00:00
WORK_END=18:00
LATE_GRACE_MINUTES=15
LUNCH_START=13:00:00
LUNCH_END=14:00:00

# ── Texnik ──
MOBILE_API_PORT=8090
DASHBOARD_PORT=8080
WORKER_POLL_SECONDS=10
WORKER_API_THREADS=8
